SIMPLE  =                    T / conforms to FITS standard                      BITPIX  =                  -64 / array data type                                NAXIS   =                    3 / number of array dimensions                     NAXIS1  =                   79                                                  NAXIS2  =                  417                                                  NAXIS3  =                    2                                                  OBSERVAT= 'Aditya-L1'          / Name of the Observatory                        INSTRUME= 'VELC    '           / Visible Emission Line Coronagraph              CHANNEL = 'Spectroscopy- 1'                                                     DETECTOR= 'VS1     '                                                            WAVELENG= '530.3 nm'                                                            FOV     = '1.05Ro to 1.5Ro'    / Field of view                                  PIXELSIZ= '6.5 microns/pixel'                                                   PLATESCL= '1.25 arcsec/pixel'                                                   SP-DISP = '28.4 mA/pixel'      / Spectral dispersion per pixel                  SLIT_WID= '50 microns'                                                          CALIBTYP= 'Science-data'       / Calibration data/Science data                  DOOR    = 'Open    '           / VELC entrance Door Open/close status           CAMERA  = 'sCMOS   '                                                            GAIN    = '1X10X   '           / Lowgain = 1x/2x, Highgain = 10x/30x            GAINCONV= '15e/DN (1X); 8.3e/DN (2X); 1.75e/DN (10X); 0.5e/DN (30X)'            TEMP    = '-5 DegC '           / Detector temperature                           PROPID  = 'T25_1071'           / Proposal ID                                    OBSID   = 'T25_1071_002447'    / Observation ID                                 DATE-OBS= '2025-07-15T10:00:16.836025000' / Start time of observation in UT     